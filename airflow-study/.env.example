# =========================================================================
# Airflow 학습 환경 — .env.example
# 사용법: 이 파일을 .env로 복사한 뒤 필요한 값만 수정하세요.
#   cp .env.example .env
# .env 파일은 .gitignore에 등록되어 커밋되지 않습니다.
#
# 표기 규칙:
#   - 활성 라인 (값 = 기본값)        → 수정 시 즉시 적용
#   - "#" 으로 시작하는 라인        → 참고용. 주석을 풀고 값을 입력하면 적용
#   - 모든 AIRFLOW__SECTION__KEY 형식은 airflow.cfg [section] key 와 1:1 매핑
# =========================================================================

# =========================================================================
# 1. 컨테이너 / 호스트 매핑 (Compose 인터폴레이션)
# =========================================================================

# 호스트 사용자 UID와 컨테이너 사용자를 맞춤 (./logs, ./dags 권한 문제 방지)
#   macOS:  50000 그대로  /  Linux: $(id -u)  /  WSL2: 50000
AIRFLOW_UID=50000

# Airflow 이미지 태그를 바꾸려면 (예: 실험적으로 다른 버전으로 학습)
#AIRFLOW_IMAGE_NAME=apache/airflow:2.9.3

# Web UI 외부 노출 포트 (기본 8080이 다른 앱과 충돌할 때만 변경)
#AIRFLOW_WEBSERVER_PORT=8080

# 컨테이너 시작 시 추가로 설치할 pip 패키지 (공백 구분)
#   예) requests==2.32.0 pandas==2.2.2
#   ⚠ 운영에서는 커스텀 이미지 빌드 권장
_PIP_ADDITIONAL_REQUIREMENTS=

# =========================================================================
# 2. Postgres (메타데이터 DB)
# =========================================================================

# 학습용 기본값. 외부 노출 시 반드시 변경하세요.
#POSTGRES_USER=airflow
#POSTGRES_PASSWORD=airflow
#POSTGRES_DB=airflow

# =========================================================================
# 3. Airflow 관리자 계정 (airflow-init 서비스가 생성)
# =========================================================================

# 학습용 기본값 (airflow / airflow). 사내망 노출 시 반드시 변경.
#_AIRFLOW_WWW_USER_USERNAME=airflow
#_AIRFLOW_WWW_USER_PASSWORD=airflow

# =========================================================================
# 4. Airflow [core]  ─ 가장 자주 토글하는 학습용 항목
# =========================================================================

# 기본 예제 DAG 로딩 여부 (학습용 DAG만 보고 싶다면 false 권장)
#AIRFLOW__CORE__LOAD_EXAMPLES=false

# DAG 생성 시 토글 OFF로 시작할지
#AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true

# 시스템 기본 timezone (logical_date / 메타DB 저장은 UTC로 고정)
#AIRFLOW__CORE__DEFAULT_TIMEZONE=UTC

# Executor (학습 환경은 LocalExecutor 고정. 변경 시 compose 직접 수정 필요)
#AIRFLOW__CORE__EXECUTOR=LocalExecutor

# 동시성 제어
#AIRFLOW__CORE__PARALLELISM=32              # 클러스터 전체 동시 Task 수
#AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=16 # DAG 1개당 동시 Task 상한
#AIRFLOW__CORE__MAX_ACTIVE_RUNS_PER_DAG=16  # DAG 1개당 동시 DAGRun 상한

# Task 기본 재시도 횟수
#AIRFLOW__CORE__DEFAULT_TASK_RETRIES=0

# Connection / Variable 암호화 키 (운영에서는 반드시 설정)
#   생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#AIRFLOW__CORE__FERNET_KEY=

# =========================================================================
# 5. Airflow [scheduler]
# =========================================================================

# 새 DAG의 catchup 기본값 (DAG 코드에서 catchup= 미지정 시 사용)
#AIRFLOW__SCHEDULER__CATCHUP_BY_DEFAULT=false

# DAG 폴더 변경 감지 주기(초)
#AIRFLOW__SCHEDULER__DAG_DIR_LIST_INTERVAL=300

# 같은 DAG 파일을 다시 파싱하기까지 최소 간격(초)
#AIRFLOW__SCHEDULER__MIN_FILE_PROCESS_INTERVAL=30

# Scheduler heartbeat 주기(초)
#AIRFLOW__SCHEDULER__SCHEDULER_HEARTBEAT_SEC=5

# DAG 파싱에 쓰는 프로세스 수
#AIRFLOW__SCHEDULER__PARSING_PROCESSES=2

# Scheduler 헬스체크 endpoint 활성
#AIRFLOW__SCHEDULER__ENABLE_HEALTH_CHECK=true

# =========================================================================
# 6. Airflow [webserver] (UI)
# =========================================================================

# UI 표시용 기본 timezone (UTC / Asia/Seoul / system 등)
#AIRFLOW__WEBSERVER__DEFAULT_UI_TIMEZONE=UTC

# UI에서 외부 접근 시 base URL (리버스 프록시 뒤에 둘 때 필수)
#AIRFLOW__WEBSERVER__BASE_URL=http://localhost:8080

# Webserver gunicorn worker 수
#AIRFLOW__WEBSERVER__WORKERS=4

# UI에서 Configurations 페이지 노출 여부 (운영에서는 False 권장)
#AIRFLOW__WEBSERVER__EXPOSE_CONFIG=False

# Flask secret key (운영에서는 반드시 랜덤 값 설정)
#AIRFLOW__WEBSERVER__SECRET_KEY=

# =========================================================================
# 7. Airflow [database]
# =========================================================================

# 메타DB 연결 (compose가 Postgres 컨테이너로 자동 구성. 변경 시 신중)
#AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow

# 커넥션 풀 크기
#AIRFLOW__DATABASE__SQL_ALCHEMY_POOL_SIZE=5
#AIRFLOW__DATABASE__SQL_ALCHEMY_MAX_OVERFLOW=10

# =========================================================================
# 8. Airflow [logging]
# =========================================================================

# 로그 레벨 (DEBUG / INFO / WARNING / ERROR / CRITICAL)
#AIRFLOW__LOGGING__LOGGING_LEVEL=INFO

# 로그 저장 위치 (컨테이너 내부 경로)
#AIRFLOW__LOGGING__BASE_LOG_FOLDER=/opt/airflow/logs

# Remote logging (S3, GCS 등) — 학습 환경에서는 사용 안 함
#AIRFLOW__LOGGING__REMOTE_LOGGING=False
#AIRFLOW__LOGGING__REMOTE_BASE_LOG_FOLDER=s3://my-bucket/airflow-logs
#AIRFLOW__LOGGING__REMOTE_LOG_CONN_ID=

# =========================================================================
# 9. Airflow [api]
# =========================================================================

# REST API 인증 백엔드 (학습용에는 basic_auth + session)
#AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth,airflow.api.auth.backend.session

# 실험적 API (deprecated. 비활성 권장)
#AIRFLOW__API__ENABLE_EXPERIMENTAL_API=False

# =========================================================================
# 10. Airflow [email] / [smtp]  ─ 알림 발송
# =========================================================================

#AIRFLOW__EMAIL__EMAIL_BACKEND=airflow.utils.email.send_email_smtp
#AIRFLOW__SMTP__SMTP_HOST=smtp.gmail.com
#AIRFLOW__SMTP__SMTP_PORT=587
#AIRFLOW__SMTP__SMTP_USER=
#AIRFLOW__SMTP__SMTP_PASSWORD=
#AIRFLOW__SMTP__SMTP_MAIL_FROM=airflow@example.com
#AIRFLOW__SMTP__SMTP_STARTTLS=True
#AIRFLOW__SMTP__SMTP_SSL=False

# =========================================================================
# 11. Airflow [secrets]  ─ 운영용 외부 시크릿 백엔드
# =========================================================================

# Vault / AWS Secrets Manager 등으로 Variable / Connection을 외부화
#AIRFLOW__SECRETS__BACKEND=airflow.providers.amazon.aws.secrets.secrets_manager.SecretsManagerBackend
#AIRFLOW__SECRETS__BACKEND_KWARGS={"connections_prefix":"airflow/connections","variables_prefix":"airflow/variables"}

# =========================================================================
# 12. Airflow [metrics]  ─ StatsD / Prometheus
# =========================================================================

#AIRFLOW__METRICS__STATSD_ON=False
#AIRFLOW__METRICS__STATSD_HOST=localhost
#AIRFLOW__METRICS__STATSD_PORT=8125
#AIRFLOW__METRICS__STATSD_PREFIX=airflow

# =========================================================================
# 13. 시스템 timezone (컨테이너 내부 OS timezone)
# =========================================================================

#TZ=Asia/Seoul
