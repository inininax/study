# 실행 로그 (개인정보 / 사내 호스트명 노출 가능)
logs/*
!logs/.gitkeep

# SQLite 메타DB (사용 안 하지만 혹시 모를 때)
airflow.db
airflow.db-journal
airflow-webserver.pid
unittests.cfg

# 사용자가 로컬에서 편집할 수 있는 설정 (비밀 포함 가능)
airflow.cfg
webserver_config.py
config/airflow.cfg
config/webserver_config.py

