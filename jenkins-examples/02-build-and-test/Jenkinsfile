// ============================================
// 예제 02: Build and Test - 빌드 및 테스트
// ============================================
// 소스 코드를 빌드하고 테스트를 실행하는 파이프라인입니다.
// 실제 프로젝트에서 가장 많이 사용하는 기본 패턴입니다.

pipeline {
    agent any

    // 환경 변수 정의 (전체 파이프라인에서 사용 가능)
    environment {
        PROJECT_NAME = 'my-project'
        BUILD_OUTPUT_DIR = 'build'
    }

    stages {
        stage('Checkout') {
            steps {
                echo '=== 소스 코드 체크아웃 ==='
                // 실제 프로젝트에서는 checkout scm 사용
                // 현재는 예제를 위해 스킵
                echo '소스 코드를 가져옵니다...'
                sh 'mkdir -p src'
            }
        }

        stage('Install Dependencies') {
            steps {
                echo '=== 의존성 설치 ==='
                // Node.js 프로젝트 예시
                // sh 'npm install'

                // Python 프로젝트 예시
                // sh 'pip install -r requirements.txt'

                // Java/Maven 프로젝트 예시
                // sh 'mvn dependency:resolve'

                echo '의존성 설치를 시뮬레이션합니다...'
                sh 'echo "Installing dependencies..."'
            }
        }

        stage('Build') {
            steps {
                echo '=== 빌드 실행 ==='
                // Node.js: sh 'npm run build'
                // Python: sh 'python setup.py build'
                // Java/Maven: sh 'mvn clean compile'

                sh "mkdir -p ${BUILD_OUTPUT_DIR}"
                sh "echo 'Built artifact' > ${BUILD_OUTPUT_DIR}/app.txt"
                echo "빌드가 완료되었습니다. (${PROJECT_NAME})"
            }
        }

        stage('Test') {
            steps {
                echo '=== 테스트 실행 ==='
                // Node.js: sh 'npm test'
                // Python: sh 'pytest'
                // Java/Maven: sh 'mvn test'

                // 테스트 결과 시뮬레이션
                sh '''
                    echo "Running unit tests..."
                    echo "Test 1: PASSED"
                    echo "Test 2: PASSED"
                    echo "Test 3: PASSED"
                    echo "All tests passed!"
                '''
            }
        }

        stage('Code Quality') {
            steps {
                echo '=== 코드 품질 검사 ==='
                // SonarQube 예시
                // sh 'sonar-scanner'

                // Lint 예시
                // Node.js: sh 'npm run lint'
                // Python: sh 'flake8 .'

                echo '코드 품질 검사를 시뮬레이션합니다...'
                sh 'echo "No code style issues found."'
            }
        }

        stage('Package') {
            steps {
                echo '=== 패키지 생성 ==='
                // Node.js: sh 'npm pack'
                // Java/Maven: sh 'mvn package'

                sh "tar -czf ${BUILD_OUTPUT_DIR}/package.tar.gz -C ${BUILD_OUTPUT_DIR} app.txt"
                echo '패키지가 생성되었습니다.'
            }
        }
    }

    post {
        success {
            echo "빌드 ${env.BUILD_NUMBER}이 성공적으로 완료되었습니다!"
            archiveArtifacts artifacts: "${BUILD_OUTPUT_DIR}/**", fingerprint: true
        }
        failure {
            echo "빌드 ${env.BUILD_NUMBER}이 실패했습니다. 로그를 확인하세요."
        }
        changed {
            echo '빌드 상태가 변경되었습니다 (성공 -> 실패 또는 실패 -> 성공)'
        }
    }
}
