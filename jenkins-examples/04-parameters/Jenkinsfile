// ============================================
// 예제 04: Parameters - 파라미터를 받는 파이프라인
// ============================================
// 사용자 입력을 받아서 동적으로 동작하는 파이프라인입니다.
// 빌드 시 다양한 옵션을 지정할 수 있습니다.

pipeline {
    agent any

    // parameters: 빌드 시 사용자로부터 입력받음
    parameters {
        // 선택 파라미터 (허용된 배포 환경만 선택)
        choice(
            name: 'DEPLOY_ENV',
            choices: ['dev', 'staging', 'prod'],
            description: '배포 환경 (dev, staging, prod)'
        )

        // 선택 파라미터 (드롭다운)
        choice(
            name: 'BUILD_TYPE',
            choices: ['release', 'snapshot', 'hotfix'],
            description: '빌드 타입 선택'
        )

        // 불리언 파라미터 (체크박스)
        booleanParam(
            name: 'RUN_TESTS',
            defaultValue: true,
            description: '테스트 실행 여부'
        )

        booleanParam(
            name: 'SEND_NOTIFICATION',
            defaultValue: false,
            description: '결과 알림 전송 여부'
        )

        // 텍스트 파라미터
        text(
            name: 'RELEASE_NOTES',
            defaultValue: 'Release notes here...',
            description: '릴리스 노트'
        )
    }

    environment {
        APP_VERSION = "1.0.${env.BUILD_NUMBER}"
    }

    stages {
        stage('Show Parameters') {
            steps {
                echo '=== 입력된 파라미터 ==='
                echo "배포 환경: ${params.DEPLOY_ENV}"
                echo "빌드 타입: ${params.BUILD_TYPE}"
                echo "테스트 실행: ${params.RUN_TESTS}"
                echo "알림 전송: ${params.SEND_NOTIFICATION}"
                echo "릴리스 노트: ${params.RELEASE_NOTES}"
            }
        }

        stage('Build') {
            steps {
                echo '=== 빌드 실행 ==='
                echo "빌드 타입 '${params.BUILD_TYPE}'로 빌드합니다..."
                echo "버전: ${APP_VERSION}"
                sh """
                    echo "Building application..."
                    echo "Type: ${params.BUILD_TYPE}" > build-info.txt
                    echo "Version: ${env.APP_VERSION}" >> build-info.txt
                    echo "Build complete!"
                """
            }
        }

        stage('Test') {
            when {
                expression { params.RUN_TESTS == true }
            }
            steps {
                echo '=== 테스트 실행 ==='
                echo '사용자가 테스트 실행을 선택했습니다.'
                sh '''
                    echo "Running tests..."
                    echo "Test 1: PASSED"
                    echo "Test 2: PASSED"
                    echo "All tests passed!"
                '''
            }
        }

        stage('Skip Test') {
            when {
                expression { params.RUN_TESTS == false }
            }
            steps {
                echo '=== 테스트 건너뜀 ==='
                echo '사용자가 테스트 건너뛰기를 선택했습니다.'
            }
        }

        stage('Deploy') {
            steps {
                echo '=== 배포 실행 ==='

                // 환경에 따라 다른 메시지
                script {
                    if (params.DEPLOY_ENV == 'prod') {
                        echo "WARNING: 프로덕션 환경에 배포합니다!"
                        echo "배포 전 최종 확인이 필요합니다."
                    } else if (params.DEPLOY_ENV == 'staging') {
                        echo "스테이징 환경에 배포합니다."
                    } else {
                        echo "개발 환경에 배포합니다."
                    }
                }

                echo "환경: ${params.DEPLOY_ENV}"
                echo "빌드 타입: ${params.BUILD_TYPE}"
                sh "echo 'Deployed to ${params.DEPLOY_ENV}'"
            }
        }

        stage('Notify') {
            when {
                expression { params.SEND_NOTIFICATION == true }
            }
            steps {
                echo '=== 알림 전송 ==='
                echo '빌드 결과를 관련 담당자에게 알립니다...'
                echo "배포 환경: ${params.DEPLOY_ENV}"
                echo "릴리스 노트: ${params.RELEASE_NOTES}"
                sh 'echo "Notification sent!"'
            }
        }
    }

    post {
        success {
            echo "빌드 ${env.BUILD_NUMBER}이 성공적으로 완료되었습니다!"
            echo "환경: ${params.DEPLOY_ENV}, 타입: ${params.BUILD_TYPE}"
        }
        failure {
            echo "빌드가 실패했습니다."
        }
    }
}
