// ============================================
// 예제 06: Environment Variables - 환경 변수
// ============================================
// Jenkins에서 환경 변수를 정의하고 사용하는 방법을
// 보여주는 예제입니다.

pipeline {
    agent any

    // 전역 환경 변수 (모든 stage에서 사용 가능)
    environment {
        // 정적 값
        APP_NAME = 'my-application'
        COMPANY = 'example-corp'

        // 빌드 정보 활용
        BUILD_VERSION = "1.0.${env.BUILD_NUMBER}"
        BUILD_ID_LABEL = "${env.BUILD_ID}"

        // 크레덴셜 사용 예시 (Jenkins 크레덴셜 관리에 등록 필요)
        // DB_PASSWORD = credentials('database-password')
        // API_KEY = credentials('api-key')
    }

    stages {
        stage('Display Variables') {
            steps {
                echo '=== 기본 환경 변수 ==='

                // Jenkins에서 제공하는 기본 환경 변수들
                echo "JOB_NAME: ${env.JOB_NAME}"
                echo "BUILD_NUMBER: ${env.BUILD_NUMBER}"
                echo "BUILD_ID: ${env.BUILD_ID}"
                echo "BUILD_URL: ${env.BUILD_URL}"
                echo "JENKINS_URL: ${env.JENKINS_URL}"
                echo "WORKSPACE: ${env.WORKSPACE}"
                echo "NODE_NAME: ${env.NODE_NAME}"
                echo "EXECUTOR_NUMBER: ${env.EXECUTOR_NUMBER}"

                echo ''
                echo '=== 사용자 정의 환경 변수 ==='
                echo "APP_NAME: ${APP_NAME}"
                echo "COMPANY: ${COMPANY}"
                echo "BUILD_VERSION: ${BUILD_VERSION}"
                echo "BUILD_ID_LABEL: ${BUILD_ID_LABEL}"
            }
        }

        stage('Set Dynamic Variables') {
            steps {
                echo '=== 동적 환경 변수 설정 ==='

                // 스크립트 블록 내에서 동적으로 변수 설정
                script {
                    // 현재 날짜/시간 가져오기
                    env.TODAY = sh(returnStdout: true, script: 'date +%Y-%m-%d').trim()
                    env.CURRENT_TIME = sh(returnStdout: true, script: 'date +%H:%M:%S').trim()

                    // Git 정보 (실제 프로젝트에서)
                    // env.GIT_COMMIT_SHORT = sh(returnStdout: true, script: 'git rev-parse --short HEAD').trim()
                    // env.GIT_BRANCH = sh(returnStdout: true, script: 'git rev-parse --abbrev-ref HEAD').trim()

                    // 예제용 값
                    env.GIT_COMMIT_SHORT = 'abc1234'
                    env.GIT_BRANCH = 'main'
                }

                echo "오늘 날짜: ${env.TODAY}"
                echo "현재 시간: ${env.CURRENT_TIME}"
                echo "Git 커밋: ${env.GIT_COMMIT_SHORT}"
                echo "Git 브랜치: ${env.GIT_BRANCH}"
            }
        }

        stage('Use Variables in Scripts') {
            environment {
                // stage 레벨 환경 변수 (이 stage에서만 사용 가능)
                DEPLOY_TARGET = 'staging-server'
                LOG_LEVEL = 'info'
            }
            steps {
                echo '=== 스크립트에서 변수 사용 ==='

                // sh 명령어에서 변수 사용
                sh '''
                    echo "앱 이름: $APP_NAME"
                    echo "버전: $BUILD_VERSION"
                    echo "배포 대상: $DEPLOY_TARGET"
                    echo "로그 레벨: $LOG_LEVEL"
                    echo "빌드 날짜: $TODAY"
                '''

                // 조건문에서 변수 사용
                script {
                    if (env.GIT_BRANCH == 'main') {
                        echo 'main 브랜치입니다.'
                    } else {
                        echo 'feature 브랜치입니다.'
                    }
                }
            }
        }

        stage('Environment Comparison') {
            steps {
                echo '=== 환경 변수 사용 팁 ==='

                echo ''
                echo '1. environment 블록: 선언형 방식, 전체에서 사용'
                echo '2. script 내 env.XXX: 동적 할당 가능'
                echo '3. credentials(): Jenkins 크레덴셜 안전하게 사용'
                echo '4. stage 레벨 environment: 해당 stage에서만 사용'
                echo ''
                echo '주요 Jenkins 환경 변수:'
                echo '- env.WORKSPACE: 작업 공간 경로'
                echo '- env.JOB_NAME: 잡 이름'
                echo '- env.BUILD_NUMBER: 빌드 번호'
                echo '- env.CHANGE_ID: PR 번호 (Multibranch)'
                echo '- env.BRANCH_NAME: 브랜치 이름 (Multibranch)'
            }
        }
    }

    post {
        always {
            echo '=== 정리 ==='
            echo "빌드 ${BUILD_NUMBER} 완료"
            echo "버전: ${BUILD_VERSION}"
            echo "날짜: ${env.TODAY ?: '설정되지 않음'}"
        }
    }
}
