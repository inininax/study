// ============================================
// 예제 07: Post Actions - 빌드 후 처리
// ============================================
// 빌드 결과(성공/실패/취소 등)에 따라
// 다른 작업을 실행하는 방법을 보여주는 예제입니다.

pipeline {
    agent any

    environment {
        REPORT_DIR = 'build-reports'
    }

    stages {
        stage('Build') {
            steps {
                echo '=== 빌드 실행 ==='
                sh 'echo "Building application..."'
                sh 'echo "Build artifact created"'
                echo '빌드 완료'
            }
        }

        stage('Test') {
            steps {
                echo '=== 테스트 실행 ==='
                sh 'echo "Running tests..."'
                sh 'echo "All tests passed"'
            }
        }

        stage('Archive') {
            steps {
                echo '=== 결과 저장 ==='
                sh "mkdir -p ${REPORT_DIR}"
                sh "echo 'Build Report' > ${REPORT_DIR}/report.txt"
                sh "echo 'Test Results' > ${REPORT_DIR}/test-results.txt"
            }
        }
    }

    // post 블록: 빌드 결과에 따른 후처리 작업
    post {
        // 항상 실행 (성공/실패 관계없이)
        always {
            echo '=== ALWAYS: 항상 실행 ==='
            echo '빌드 결과에 관계없이 실행됩니다.'
            sh "mkdir -p ${REPORT_DIR}"
            sh "echo 'Cleaning up workspace...'"

            // 테스트 결과 보관 (실제 프로젝트)
            // junit 'test-results/**/*.xml'
            // archiveArtifacts artifacts: 'build/**/*', fingerprint: true
        }

        // 성공 시에만 실행
        success {
            echo '=== SUCCESS: 성공 시 실행 ==='
            echo '빌드가 성공적으로 완료되었습니다!'
            sh "echo 'Success notification sent' > ${REPORT_DIR}/notification.txt"

            // 성공 시 알림 전송 예시
            // slackSend(color: 'good', message: "빌드 성공: ${env.JOB_NAME} #${env.BUILD_NUMBER}")
            // mail to: 'team@example.com', subject: "빌드 성공", body: "빌드가 완료되었습니다."
        }

        // 실패 시에만 실행
        failure {
            echo '=== FAILURE: 실패 시 실행 ==='
            echo '빌드가 실패했습니다! 확인이 필요합니다.'

            // 실패 시 알림 전송 예시
            // slackSend(color: 'danger', message: "빌드 실패: ${env.JOB_NAME} #${env.BUILD_NUMBER}")
            // mail to: 'team@example.com', subject: "빌드 실패", body: "빌드가 실패했습니다. 로그를 확인하세요."

            sh "echo 'Failure alert sent!' > ${REPORT_DIR}/alert.txt"
        }

        // 취소 시 실행 (수동 중단 등)
        aborted {
            echo '=== ABORTED: 취소 시 실행 ==='
            echo '빌드가 취소되었습니다.'
            sh "echo 'Build was aborted' > ${REPORT_DIR}/aborted.txt"
        }

        // unstable 시 실행 (테스트 실패 등)
        unstable {
            echo '=== UNSTABLE: 불안정 시 실행 ==='
            echo '빌드가 불안정합니다 (테스트 실패 등)'
            sh "echo 'Build is unstable' > ${REPORT_DIR}/unstable.txt"
        }

        // 상태 변경 시 실행 (이전 빌드와 다를 때)
        changed {
            echo '=== CHANGED: 상태 변경 시 실행 ==='
            echo '빌드 상태가 이전과 다릅니다.'
            echo '(예: 성공 -> 실패, 실패 -> 성공)'
        }

        // cleanup: 가장 마지막에 항상 실행
        cleanup {
            echo '=== CLEANUP: 최종 정리 ==='
            echo '모든 post 작업이 완료된 후 실행됩니다.'
            sh "echo 'Final cleanup completed'"
        }
    }
}
