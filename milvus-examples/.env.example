# Milvus Configuration
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB_NAME=default
MILVUS_SECURE=false

# Connection Pool
MILVUS_POOL_SIZE=10
MILVUS_MAX_IDLE_TIME=300
MILVUS_CONNECTION_TIMEOUT=30

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_TTL=3600

# OpenAI (for embeddings)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=text-embedding-3-small

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/milvus-app.log

# Performance
BATCH_SIZE=1000
SEARCH_TOPK=10
INDEX_TYPE=HNSW
METRIC_TYPE=L2

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=8000
PROMETHEUS_ENABLED=true

# Development
DEBUG=false
ENVIRONMENT=development

# Docker Volume Directory
DOCKER_VOLUME_DIRECTORY=./data
