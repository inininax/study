# Weaviate 설정
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=

# OpenAI 설정 (벡터화에 사용)
OPENAI_API_KEY=your_openai_api_key_here

# Cohere 설정 (선택사항)
COHERE_API_KEY=

# Hugging Face 설정 (선택사항)
HUGGINGFACE_API_KEY=

# 애플리케이션 설정
APP_ENV=development
LOG_LEVEL=INFO

# 데이터베이스 설정 (프로젝트용)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=weaviate_app
DB_USER=admin
DB_PASSWORD=password
